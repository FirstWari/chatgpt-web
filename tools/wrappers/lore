#!/bin/bash
# lore-engine wrapper (server): WARP egress, browser-consistent UA, PO Token provider,
# shared net lock, and one automatic WARP rotation when YouTube raises a bot check.
export HTTP_PROXY=socks5://127.0.0.1:40000 HTTPS_PROXY=socks5://127.0.0.1:40000
export LORE_USER_AGENT="${LORE_USER_AGENT:-Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/152.0.0.0 Safari/537.36}"
export LORE_YTDLP_OPTS_JSON="${LORE_YTDLP_OPTS_JSON:-{\"extractor_args\": {\"youtubepot-bgutilhttp\": {\"base_url\": [\"http://127.0.0.1:4416\"]}}}}"
cd "$HOME/work/lore-engine" || exit 1
run() { flock -s "$HOME/work/net.lock" .venv/bin/python lore.py "$@"; }
out=$(run "$@" 2> >(tee /tmp/lore.err >&2)); rc=$?
if [ $rc -ne 0 ] && grep -qiE "not a bot|Sign in to confirm|HTTP Error 429|Too Many Requests" /tmp/lore.err "$out" 2>/dev/null; then
  echo "[lore-wrapper] bot check / rate limit detected -> rotating WARP egress and retrying once" >&2
  "$HOME/work/bin/warp-rotate" >&2 || true
  sleep 15
  out=$(run "$@"); rc=$?
fi
printf '%s\n' "$out"
exit $rc
